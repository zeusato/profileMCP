{
  "name": "profile-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated, read-only SHA MCP on Vercel with a private Supabase store",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/local.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:contract": "tsx --test tests/contracts.test.ts",
    "test:security": "tsx --test tests/security.test.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke:esm": "node scripts/smoke-esm.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "probe:sha": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/oidc-provider": "9.12.1",
    "node": "24.21.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vercel": "63.1.0"
  }
}
