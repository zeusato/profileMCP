{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["syd1"],
  "functions": { "api/index.ts": { "maxDuration": 30, "includeFiles": "config/*.json" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
